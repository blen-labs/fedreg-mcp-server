{
  "name": "@blen/fedreg-mcp-server",
  "version": "2.1.0",
  "description": "Code-mode MCP server for the U.S. Federal Register, Electronic Code of Federal Regulations, and regulations.gov APIs.",
  "license": "Apache-2.0",
  "author": "BLEN, Inc. (https://blenlabs.com)",
  "homepage": "https://github.com/blen-labs/fedreg-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blen-labs/fedreg-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/blen-labs/fedreg-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "federal-register",
    "ecfr",
    "regulations.gov",
    "public-comments",
    "code-mode",
    "sandbox",
    "isolated-vm",
    "ai-agents",
    "claude",
    "anthropic",
    "regulations",
    "government-data"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fedreg-mcp-server": "dist/bin.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:web && (chmod +x dist/bin.js || true)",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "prepack": "pnpm run build",
    "mcpb:prepare": "node scripts/mcpb-prepare.mjs",
    "mcpb:pack": "mcpb pack mcpb-build fedreg-mcp-server.mcpb",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite build --watch --config web/vite.config.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "acorn": "^8.12.1",
    "acorn-walk": "^8.3.4",
    "better-auth": "1.7.7",
    "express": "5.2.1",
    "jose": "^6.2.12",
    "lru-cache": "^11.0.2",
    "pg": "8.23.1",
    "undici": "^6.21.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "isolated-vm": "^5.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/client": "2.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "^9.17.0",
    "fetch-cookie": "3.2.0",
    "lucide-react": "1.48.0",
    "nock": "^14.0.0-beta.19",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tough-cookie": "6.0.2",
    "tsx": "^4.19.2",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.7.2",
    "vite": "8.3.1",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
