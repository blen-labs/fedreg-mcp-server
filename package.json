{
  "name": "@blen/fedreg-mcp-server",
  "version": "4.2.0",
  "description": "Code-mode MCP server for the U.S. Federal Register, Electronic Code of Federal Regulations, and regulations.gov APIs.",
  "license": "Apache-2.0",
  "author": "BLEN, Inc. (https://blenlabs.com)",
  "homepage": "https://github.com/blen-labs/fedreg-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blen-labs/fedreg-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/blen-labs/fedreg-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "federal-register",
    "ecfr",
    "regulations.gov",
    "public-comments",
    "code-mode",
    "sandbox",
    "isolated-vm",
    "ai-agents",
    "claude",
    "anthropic",
    "regulations",
    "government-data"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fedreg-mcp-server": "dist/bin.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": "^24.11.0 || ^26.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:web && (chmod +x dist/bin.js || true)",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p web/e2e/tsconfig.json",
    "prepack": "pnpm run build",
    "mcpb:prepare": "node scripts/mcpb-prepare.mjs",
    "mcpb:pack": "mcpb pack mcpb-build fedreg-mcp-server.mcpb",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite build --watch --config web/vite.config.ts",
    "test:web": "pnpm build:web && pnpm --dir site build && playwright test",
    "docs:check": "node scripts/check-docs.mjs",
    "kit:check": "node scripts/portal-kit.mjs",
    "kit:update": "node scripts/portal-kit.mjs --update"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.26",
    "@better-auth/mcp": "1.7.26",
    "@better-auth/oauth-provider": "1.7.26",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "better-auth": "1.7.26",
    "express": "5.3.0",
    "jose": "^6.2.18",
    "lru-cache": "^11.5.3",
    "pg": "8.23.1",
    "undici": "^8.13.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "isolated-vm": "^7.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fetch-cookie": "3.2.0",
    "globals": "^17.14.0",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "railway": "3.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.2",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tough-cookie": "6.1.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
