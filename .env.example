# Transport — pick via CLI flag (default: stdio)
#   fedreg-mcp-server            # stdio
#   fedreg-mcp-server --http     # Streamable HTTP
PORT=8080
HOST=0.0.0.0
FEDREG_LOG_LEVEL=info                # debug | info | warn | error

# Sandbox
FEDREG_SANDBOX=auto                  # auto | isolate | deno
# execute() limits are per-call tool arguments, not env vars:
# timeoutMs (default 15000, max 60000) and memoryMb (default 64, max 256).

# Upstream
FEDREG_FR_BASE_URL=https://www.federalregister.gov/api/v1
FEDREG_ECFR_BASE_URL=https://www.ecfr.gov/api
FEDREG_REGS_BASE_URL=https://api.regulations.gov
# regulations.gov requires a free API key from https://open.gsa.gov/api/regulationsgov/
# Without it, the `regs` source is disabled (fr/ecfr keep working).
FEDREG_REGS_API_KEY=
# Max regulations.gov upstream calls per single execute() run (rate-limit guardrail).
FEDREG_REGS_MAX_CALLS_PER_EXECUTE=30
# Process-wide cap on regulations.gov upstream calls per hour (protects the shared API key).
# In-memory/single-process: with N replicas, divide by N or use per-replica keys. Must be >= 1.
FEDREG_REGS_RATE_PER_HOUR=1000
# Per-authenticated-subject regulations.gov calls per hour (HTTP auth mode only; ignored in
# account mode, which uses FEDREG_REGS_RATE_PER_HOUR per account). Must be >= 1.
FEDREG_REGS_SUBJECT_RATE_PER_HOUR=500
# Identify yourself per FederalRegister.gov / eCFR etiquette.
FEDREG_USER_AGENT=fedreg-mcp-server/2.0 (+https://github.com/blen-labs/fedreg-mcp-server)
FEDREG_UPSTREAM_TIMEOUT_MS=20000
# Retries for network errors and 5xx. An upstream 429 is retried at most once, after its
# Retry-After (capped at 5s), and pauses all calls to that API meanwhile.
FEDREG_UPSTREAM_RETRIES=3
# Federal Register and eCFR see every user of this server as one client (one egress IP).
# Per API, shared by all users: requests in flight, and requests started per second.
FEDREG_UPSTREAM_CONCURRENCY=8
FEDREG_UPSTREAM_RATE_PER_SEC=10
# Longest a call waits for a slot before failing with RateLimited.
FEDREG_UPSTREAM_MAX_WAIT_MS=15000
# Max Federal Register + eCFR calls per single execute() run. Must be >= 1.
FEDREG_PUBLIC_MAX_CALLS_PER_EXECUTE=100

# Cache
FEDREG_CACHE_TTL_MS=300000
FEDREG_CACHE_MAX_ITEMS=2000

# ─── HTTP transport ─────────────────────────────────────────────────────────
# Set this to the public origin that clients reach (used in OAuth resource
# metadata and the WWW-Authenticate header).
FEDREG_PUBLIC_ORIGIN=https://your-host.example.com
# Comma-separated Host header allowlist (DNS-rebinding protection).
# Leave unset to disable (NOT recommended in production).
FEDREG_ALLOWED_HOSTS=your-host.example.com
# Extra browser Origins allowed on /mcp (comma-separated exact origins). The
# server's own origin and loopback are always allowed; requests without an
# Origin header (non-browser MCP clients) always pass; anything else is 403.
FEDREG_ALLOWED_ORIGINS=

# Rate limiting (per IP token bucket). RPS must be > 0 and BURST >= 1.
FEDREG_IP_RPS=5
FEDREG_IP_BURST=20
# Header your reverse proxy overwrites with the client address; Railway: x-real-ip.
# Unset, the limit keys on the TCP peer, which behind a proxy is the proxy itself, so
# clients are not limited individually. Only name a header the proxy always overwrites,
# or clients can forge it. (On Railway, X-Forwarded-For is "<client>, <edge>": not usable.)
# Also keys account mode's per-IP and OAuth limits; set it there too.
FEDREG_CLIENT_IP_HEADER=
# Per authenticated subject, requests per UTC day
FEDREG_SUBJECT_DAILY_QUOTA=10000

# ─── Auth ────────────────────────────────────────────────────────────────────
# accounts  - Google sign-in, personal encrypted keys, OAuth/PKCE (see docs/accounts.md)
# none      - no auth (combine with --insecure for HTTP)
# embedded  - accepts ANY bearer token as subject 'anonymous' (NO verification; DEV ONLY)
# generic-oidc / clerk / workos / auth0 - JWKS bearer verification via jose
FEDREG_AUTH_PROVIDER=none
FEDREG_AUTH_ISSUER=
FEDREG_AUTH_AUDIENCE=
FEDREG_AUTH_JWKS_URL=
FEDREG_AUTH_RESOURCE=
# Comma-separated scopes advertised in resource metadata.
FEDREG_AUTH_SCOPES=

# Required only with FEDREG_AUTH_PROVIDER=accounts. Use a dedicated PostgreSQL database.
DATABASE_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON map of key IDs to 32-byte base64 encryption keys. Keep old keys during rotation.
ENCRYPTION_KEYS_JSON=
ENCRYPTION_ACTIVE_KEY_ID=v1
# Account mode serves /mcp (no sign-in) and /mcp/account (OAuth). Signed-in users always
# use their own key at https://api.regulations.gov; FEDREG_REGS_API_KEY, if set, serves only
# the anonymous /mcp. FEDREG_REGS_RATE_PER_HOUR is enforced per account in PostgreSQL.
